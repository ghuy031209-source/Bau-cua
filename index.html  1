<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BẦU CUA COIN</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Các file âm thanh từ nguồn CDN công khai -->
    <audio id="sound-roll" src="https://assets.mixkit.co/active_storage/sfx/2008/2008-preview.mp3" preload="auto"></audio>
    <audio id="sound-win" src="https://assets.mixkit.co/active_storage/sfx/1435/1435-preview.mp3" preload="auto"></audio>
    <audio id="sound-jackpot" src="https://assets.mixkit.co/active_storage/sfx/2019/2019-preview.mp3" preload="auto"></audio>
    <audio id="sound-coin" src="https://assets.mixkit.co/active_storage/sfx/888/888-preview.mp3" preload="auto"></audio>

    <div class="header">
        <h1>🎲 BẦU CUA COIN 🎲</h1>
        <div class="subtitle">Game giải trí • Coin ảo</div>
        
        <div class="coin-balance">
            <span>🪙</span>
            <span id="coin-amount">1000</span>
        </div>

        <div class="stats-bar">
            <div class="stat-box">🏆 Kỷ lục<br><b id="high-score">1000</b></div>
            <div class="stat-box">🔥 Chuỗi thắng<br><b id="win-streak">0</b></div>
            <div class="stat-box">🎲 Số ván<br><b id="total-games">0</b></div>
        </div>
    </div>

    <div class="container">
        <!-- Bàn đặt cược 6 con -->
        <div class="mascot-grid">
            <div class="mascot-card" onclick="selectMascot('🍐', this)">
                <span class="icon">🍐</span>
                <span class="name">Bầu</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🦀', this)">
                <span class="icon">🦀</span>
                <span class="name">Cua</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🦐', this)">
                <span class="icon">🦐</span>
                <span class="name">Tôm</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🐟', this)">
                <span class="icon">🐟</span>
                <span class="name">Cá</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🐓', this)">
                <span class="icon">🐓</span>
                <span class="name">Gà</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🦌', this)">
                <span class="icon">🦌</span>
                <span class="name">Nai</span>
            </div>
        </div>

        <!-- Mức đặt cược -->
        <div class="bet-section">
            <div class="section-title">🪙 Coin cược mỗi linh vật:</div>
            <div class="bet-options">
                <button class="bet-btn active" onclick="setBet(100, this)">100</button>
                <button class="bet-btn" onclick="setBet(200, this)">200</button>
                <button class="bet-btn" onclick="setBet(500, this)">500</button>
                <button class="bet-btn" onclick="setBet(1000, this)">1000</button>
            </div>
        </div>

        <!-- Khu vực hiển thị xúc xắc & Nút Lắc -->
        <div class="dice-section">
            <div class="dice-container">
                <div class="dice" id="dice-1">❓</div>
                <div class="dice" id="dice-2">❓</div>
                <div class="dice" id="dice-3">❓</div>
            </div>
            <button id="btn-roll" class="btn-roll" onclick="rollDice()">🎲 LẮC!</button>
        </div>

        <!-- Nhiệm vụ & Lịch sử -->
        <div class="info-card">
            <div class="info-title">🎁 Nhiệm vụ hôm nay</div>
            <div>Chơi 5 ván để nhận <b>+500 🪙</b></div>
            <div class="progress-bar"><div id="task-progress" style="width: 0%;"></div></div>
        </div>

        <div class="info-card">
            <div class="info-title">📜 Lịch sử gần đây</div>
            <div id="history-list">Chưa có ván nào.</div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
