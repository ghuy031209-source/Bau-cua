<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BẦU CUA COIN</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #121212;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            touch-action: manipulation; /* Bỏ độ trễ 300ms khi bấm trên điện thoại */
            overflow-x: hidden;
            padding-bottom: 30px;
        }

        .header {
            text-align: center;
            padding: 15px;
            width: 100%;
            max-width: 500px;
        }

        h1 {
            font-size: 24px;
            color: #ffd700;
        }

        .subtitle {
            font-size: 13px;
            color: #aaa;
            margin-bottom: 10px;
        }

        .coin-balance {
            background-color: #222;
            padding: 8px 20px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 20px;
            font-weight: bold;
            color: #ffd700;
            border: 1px solid #444;
        }

        .stats-bar {
            display: flex;
            justify-content: space-around;
            margin-top: 15px;
            background: #1e1e1e;
            padding: 10px;
            border-radius: 10px;
        }

        .stat-box {
            font-size: 12px;
            color: #ccc;
            text-align: center;
        }

        .container {
            width: 100%;
            max-width: 500px;
            padding: 0 10px;
        }

        /* Responsive Grid 3 Cột */
        .mascot-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 15px;
        }

        .mascot-card {
            background-color: #2a2a2a;
            border: 2px solid #333;
            border-radius: 12px;
            padding: 12px 5px;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: transform 0.15s ease, border-color 0.15s ease;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        .mascot-card:active {
            transform: scale(0.92);
        }

        .mascot-card.selected {
            border-color: #ffd700;
            background-color: #38321a;
        }

        .mascot-card .icon {
            font-size: 32px;
        }

        .mascot-card .name {
            font-size: 14px;
            margin-top: 4px;
            font-weight: bold;
        }

        /* Mức Cược */
        .bet-section {
            margin-top: 15px;
        }

        .section-title {
            font-size: 14px;
            margin-bottom: 8px;
            color: #bbb;
        }

        .bet-options {
            display: flex;
            gap: 8px;
        }

        .bet-btn {
            flex: 1;
            padding: 10px 0;
            background: #2a2a2a;
            border: 1px solid #444;
            color: #fff;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.1s;
            -webkit-tap-highlight-color: transparent;
        }

        .bet-btn:active {
            transform: scale(0.92);
        }

        .bet-btn.active {
            background: #ffd700;
            color: #000;
            border-color: #ffd700;
        }

        /* Xúc Xắc */
        .dice-section {
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .dice-container {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }

        .dice {
            width: 65px;
            height: 65px;
            background-color: #fff;
            color: #000;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 32px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }

        /* HIỆU ỨNG RUNG LẮC XÚC XẮC */
        .dice-shake {
            animation: shake 0.6s infinite ease-in-out;
        }

        @keyframes shake {
            0% { transform: translate(0, 0) rotate(0deg) scale(1); }
            20% { transform: translate(-8px, 5px) rotate(-12deg) scale(1.1); }
            40% { transform: translate(8px, -5px) rotate(12deg) scale(1.1); }
            60% { transform: translate(-5px, -8px) rotate(-8deg) scale(1.05); }
            80% { transform: translate(5px, 8px) rotate(8deg) scale(1.05); }
            100% { transform: translate(0, 0) rotate(0deg) scale(1); }
        }

        .btn-roll {
            width: 100%;
            padding: 14px;
            font-size: 18px;
            font-weight: bold;
            background: linear-gradient(135deg, #ff4e50, #f9d423);
            border: none;
            border-radius: 10px;
            color: #fff;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(255, 78, 80, 0.4);
            transition: opacity 0.2s;
            -webkit-tap-highlight-color: transparent;
        }

        .btn-roll:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* Nhiệm vụ & Lịch sử */
        .info-card {
            background: #1e1e1e;
            border-radius: 10px;
            padding: 12px;
            margin-top: 15px;
            font-size: 13px;
        }

        .info-title {
            font-weight: bold;
            margin-bottom: 6px;
            color: #ffd700;
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            background: #333;
            border-radius: 3px;
            margin-top: 8px;
            overflow: hidden;
        }

        .progress-bar div {
            height: 100%;
            background: #ffd700;
            transition: width 0.3s;
        }
    </style>
</head>
<body>

    <!-- Các tệp âm thanh trực tuyến -->
    <audio id="sound-roll" src="https://assets.mixkit.co/active_storage/sfx/2008/2008-preview.mp3" preload="auto"></audio>
    <audio id="sound-win" src="https://assets.mixkit.co/active_storage/sfx/1435/1435-preview.mp3" preload="auto"></audio>
    <audio id="sound-jackpot" src="https://assets.mixkit.co/active_storage/sfx/2019/2019-preview.mp3" preload="auto"></audio>
    <audio id="sound-coin" src="https://assets.mixkit.co/active_storage/sfx/888/888-preview.mp3" preload="auto"></audio>

    <div class="header">
        <h1>🎲 BẦU CUA COIN 🎲</h1>
        <div class="subtitle">Game giải trí • Coin ảo</div>
        
        <div class="coin-balance">
            <span>🪙</span>
            <span id="coin-amount">1000</span>
        </div>

        <div class="stats-bar">
            <div class="stat-box">🏆 Kỷ lục<br><b id="high-score">1000</b></div>
            <div class="stat-box">🔥 Chuỗi thắng<br><b id="win-streak">0</b></div>
            <div class="stat-box">🎲 Số ván<br><b id="total-games">0</b></div>
        </div>
    </div>

    <div class="container">
        <!-- Bàn đặt cược 6 linh vật -->
        <div class="mascot-grid">
            <div class="mascot-card" onclick="selectMascot('🍐', this)">
                <span class="icon">🍐</span>
                <span class="name">Bầu</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🦀', this)">
                <span class="icon">🦀</span>
                <span class="name">Cua</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🦐', this)">
                <span class="icon">🦐</span>
                <span class="name">Tôm</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🐟', this)">
                <span class="icon">🐟</span>
                <span class="name">Cá</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🐓', this)">
                <span class="icon">🐓</span>
                <span class="name">Gà</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🦌', this)">
                <span class="icon">🦌</span>
                <span class="name">Nai</span>
            </div>
        </div>

        <!-- Mức cược -->
        <div class="bet-section">
            <div class="section-title">🪙 Coin cược mỗi linh vật:</div>
            <div class="bet-options">
                <button class="bet-btn active" onclick="setBet(100, this)">100</button>
                <button class="bet-btn" onclick="setBet(200, this)">200</button>
                <button class="bet-btn" onclick="setBet(500, this)">500</button>
                <button class="bet-btn" onclick="setBet(1000, this)">1000</button>
            </div>
        </div>

        <!-- Xúc xắc & Nút Lắc -->
        <div class="dice-section">
            <div class="dice-container">
                <div class="dice" id="dice-1">❓</div>
                <div class="dice" id="dice-2">❓</div>
                <div class="dice" id="dice-3">❓</div>
            </div>
            <button id="btn-roll" class="btn-roll" onclick="rollDice()">🎲 LẮC!</button>
        </div>

        <!-- Nhiệm vụ & Lịch sử -->
        <div class="info-card">
            <div class="info-title">🎁 Nhiệm vụ hôm nay</div>
            <div>Chơi 5 ván để nhận <b>+500 🪙</b></div>
            <div class="progress-bar"><div id="task-progress" style="width: 0%;"></div></div>
        </div>

        <div class="info-card">
            <div class="info-title">📜 Lịch sử gần đây</div>
            <div id="history-list">Chưa có ván nào.</div>
        </div>
    </div>

    <!-- LOGIC XỬ LÝ SỰ KIỆN & GAMEPLAY -->
    <script>
        const mascots = ['🍐', '🦀', '🦐', '🐟', '🐓', '🦌'];

        let coin = 1000;
        let currentBetAmount = 100;
        let selectedMascots = [];
        let streak = 0;
        let gamesPlayed = 0;
        let highScore = 1000;

        // Hàm phát âm thanh
        function playSound(id) {
            const sound = document.getElementById(id);
            if (sound) {
                sound.currentTime = 0;
                sound.play().catch(() => {});
            }
        }

        // Chọn / Bỏ chọn linh vật (tối đa 3 con)
        function selectMascot(mascot, element) {
            playSound('sound-coin');
            
            if (selectedMascots.includes(mascot)) {
                selectedMascots = selectedMascots.filter(m => m !== mascot);
                element.classList.remove('selected');
            } else {
                if (selectedMascots.length >= 3) {
                    alert("Bạn chỉ được chọn tối đa 3 linh vật!");
                    return;
                }
                selectedMascots.push(mascot);
                element.classList.add('selected');
            }
        }

        // Đổi mức cược
        function setBet(amount, element) {
            playSound('sound-coin');
            currentBetAmount = amount;
            document.querySelectorAll('.bet-btn').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');
        }

        // Lắc xúc xắc
        function rollDice() {
            if (selectedMascots.length === 0) {
                alert("Vui lòng chọn ít nhất 1 linh vật để đặt cược!");
                return;
            }

            const totalBetCost = currentBetAmount * selectedMascots.length;
            if (coin < totalBetCost) {
                alert("Bạn không đủ Coin để đặt cược!");
                return;
            }

            // Trừ tiền cược
            coin -= totalBetCost;
            updateUI();

            const btnRoll = document.getElementById('btn-roll');
            const diceElements = [
                document.getElementById('dice-1'),
                document.getElementById('dice-2'),
                document.getElementById('dice-3')
            ];

            btnRoll.disabled = true;
            playSound('sound-roll');

            // Bắt đầu hiệu ứng lắc (xoay/rung xắc)
            diceElements.forEach(dice => {
                dice.textContent = '❓';
                dice.classList.add('dice-shake');
            });

            // Sau 1.2s kết thúc hiệu ứng và trả kết quả
            setTimeout(() => {
                diceElements.forEach(dice => dice.classList.remove('dice-shake'));

                // Random 3 mặt xúc xắc
                const results = [
                    mascots[Math.floor(Math.random() * mascots.length)],
                    mascots[Math.floor(Math.random() * mascots.length)],
                    mascots[Math.floor(Math.random() * mascots.length)]
                ];

                diceElements[0].textContent = results[0];
                diceElements[1].textContent = results[1];
                diceElements[2].textContent = results[2];

                // Tính điểm & cộng coin
                calculateResult(results, totalBetCost);

                btnRoll.disabled = false;
            }, 1200);
        }

        // Tính kết quả
        function calculateResult(results, totalBetCost) {
            let winnings = 0;
            let matchCount = 0;

            selectedMascots.forEach(mascot => {
                const count = results.filter(r => r === mascot).length;
                if (count > 0) {
                    winnings += (currentBetAmount * count) + currentBetAmount;
                    matchCount += count;
                }
            });

            coin += winnings;
            gamesPlayed++;

            if (winnings > 0) {
                streak++;
                if (matchCount === 3 && selectedMascots.length === 1) {
                    playSound('sound-jackpot');
                } else {
                    playSound('sound-win');
                }
            } else {
                streak = 0;
            }

            if (coin > highScore) {
                highScore = coin;
            }

            // Cập nhật lịch sử
            const historyList = document.getElementById('history-list');
            const netProfit = winnings - totalBetCost;
            const resultText = netProfit >= 0 ? `+${netProfit}` : `${netProfit}`;
            const historyItem = document.createElement('div');
            historyItem.style.margin = "4px 0";
            historyItem.textContent = `Ván ${gamesPlayed}: ${results.join(' ')} (${resultText} 🪙)`;
            
            if (historyList.textContent === "Chưa có ván nào.") historyList.textContent = "";
            historyList.prepend(historyItem);

            updateUI();
        }

        // Cập nhật giao diện
        function updateUI() {
            document.getElementById('coin-amount').textContent = coin;
            document.getElementById('high-score').textContent = highScore;
            document.getElementById('win-streak').textContent = streak;
            document.getElementById('total-games').textContent = gamesPlayed;

            const progressPercent = Math.min((gamesPlayed / 5) * 100, 100);
            document.getElementById('task-progress').style.width = progressPercent + '%';

            if (gamesPlayed === 5 && !window.taskRewarded) {
                coin += 500;
                window.taskRewarded = true;
                alert("🎉 Chúc mừng bạn đã hoàn thành nhiệm vụ 5 ván và nhận +500 🪙!");
                document.getElementById('coin-amount').textContent = coin;
            }
        }
    </script>
</body>
</html>
