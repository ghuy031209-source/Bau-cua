<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BẦU CUA COIN</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #121212;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            touch-action: manipulation;
            overflow-x: hidden;
            padding-bottom: 30px;
        }

        .header {
            text-align: center;
            padding: 15px;
            width: 100%;
            max-width: 500px;
        }

        h1 {
            font-size: 24px;
            color: #ffd700;
        }

        .subtitle {
            font-size: 13px;
            color: #aaa;
            margin-bottom: 6px;
        }

        .sound-status {
            font-size: 11px;
            color: #ffca28;
            background: #2a2208;
            padding: 4px 10px;
            border-radius: 12px;
            display: inline-block;
            border: 1px solid #554300;
            margin-bottom: 8px;
        }

        .coin-balance {
            background-color: #222;
            padding: 8px 20px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 20px;
            font-weight: bold;
            color: #ffd700;
            border: 1px solid #444;
        }

        .stats-bar {
            display: flex;
            justify-content: space-around;
            margin-top: 15px;
            background: #1e1e1e;
            padding: 10px;
            border-radius: 10px;
        }

        .stat-box {
            font-size: 12px;
            color: #ccc;
            text-align: center;
        }

        .container {
            width: 100%;
            max-width: 500px;
            padding: 0 10px;
        }

        /* Grid 3 cột mượt cho điện thoại */
        .mascot-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 15px;
        }

        .mascot-card {
            background-color: #2a2a2a;
            border: 2px solid #333;
            border-radius: 12px;
            padding: 12px 5px;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: transform 0.15s ease, border-color 0.15s ease;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        .mascot-card:active {
            transform: scale(0.92);
        }

        .mascot-card.selected {
            border-color: #ffd700;
            background-color: #38321a;
        }

        .mascot-card .icon {
            font-size: 32px;
        }

        .mascot-card .name {
            font-size: 14px;
            margin-top: 4px;
            font-weight: bold;
        }

        .bet-section {
            margin-top: 15px;
        }

        .section-title {
            font-size: 14px;
            margin-bottom: 8px;
            color: #bbb;
        }

        .bet-options {
            display: flex;
            gap: 8px;
        }

        .bet-btn {
            flex: 1;
            padding: 10px 0;
            background: #2a2a2a;
            border: 1px solid #444;
            color: #fff;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.1s;
            -webkit-tap-highlight-color: transparent;
        }

        .bet-btn:active {
            transform: scale(0.92);
        }

        .bet-btn.active {
            background: #ffd700;
            color: #000;
            border-color: #ffd700;
        }

        .dice-section {
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .dice-container {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }

        .dice {
            width: 65px;
            height: 65px;
            background-color: #fff;
            color: #000;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 32px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }

        /* Hiệu ứng xoay lắc xúc xắc */
        .dice-shake {
            animation: shake 0.5s infinite ease-in-out;
        }

        @keyframes shake {
            0% { transform: translate(0, 0) rotate(0deg) scale(1); }
            20% { transform: translate(-8px, 5px) rotate(-12deg) scale(1.1); }
            40% { transform: translate(8px, -5px) rotate(12deg) scale(1.1); }
            60% { transform: translate(-5px, -8px) rotate(-8deg) scale(1.05); }
            80% { transform: translate(5px, 8px) rotate(8deg) scale(1.05); }
            100% { transform: translate(0, 0) rotate(0deg) scale(1); }
        }

        .btn-roll {
            width: 100%;
            padding: 14px;
            font-size: 18px;
            font-weight: bold;
            background: linear-gradient(135deg, #ff4e50, #f9d423);
            border: none;
            border-radius: 10px;
            color: #fff;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(255, 78, 80, 0.4);
            transition: opacity 0.2s;
            -webkit-tap-highlight-color: transparent;
        }

        .btn-roll:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .info-card {
            background: #1e1e1e;
            border-radius: 10px;
            padding: 12px;
            margin-top: 15px;
            font-size: 13px;
        }

        .info-title {
            font-weight: bold;
            margin-bottom: 6px;
            color: #ffd700;
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            background: #333;
            border-radius: 3px;
            margin-top: 8px;
            overflow: hidden;
        }

        .progress-bar div {
            height: 100%;
            background: #ffd700;
            transition: width 0.3s;
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>🎲 BẦU CUA COIN 🎲</h1>
        <div class="subtitle">Game giải trí • Coin ảo</div>
        <div class="sound-status" id="sound-status">🔔 Bấm chọn linh vật bất kỳ để bật Âm Thanh</div>
        <br>
        <div class="coin-balance">
            <span>🪙</span>
            <span id="coin-amount">1000</span>
        </div>

        <div class="stats-bar">
            <div class="stat-box">🏆 Kỷ lục<br><b id="high-score">1000</b></div>
            <div class="stat-box">🔥 Chuỗi thắng<br><b id="win-streak">0</b></div>
            <div class="stat-box">🎲 Số ván<br><b id="total-games">0</b></div>
        </div>
    </div>

    <div class="container">
        <!-- Bàn đặt cược -->
        <div class="mascot-grid">
            <div class="mascot-card" onclick="selectMascot('🍐', this)">
                <span class="icon">🍐</span>
                <span class="name">Bầu</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🦀', this)">
                <span class="icon">🦀</span>
                <span class="name">Cua</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🦐', this)">
                <span class="icon">🦐</span>
                <span class="name">Tôm</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🐟', this)">
                <span class="icon">🐟</span>
                <span class="name">Cá</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🐓', this)">
                <span class="icon">🐓</span>
                <span class="name">Gà</span>
            </div>
            <div class="mascot-card" onclick="selectMascot('🦌', this)">
                <span class="icon">🦌</span>
                <span class="name">Nai</span>
            </div>
        </div>

        <!-- Mức cược -->
        <div class="bet-section">
            <div class="section-title">🪙 Coin cược mỗi linh vật:</div>
            <div class="bet-options">
                <button class="bet-btn active" onclick="setBet(100, this)">100</button>
                <button class="bet-btn" onclick="setBet(200, this)">200</button>
                <button class="bet-btn" onclick="setBet(500, this)">500</button>
                <button class="bet-btn" onclick="setBet(1000, this)">1000</button>
            </div>
        </div>

        <!-- Xúc xắc & Nút Lắc -->
        <div class="dice-section">
            <div class="dice-container">
                <div class="dice" id="dice-1">❓</div>
                <div class="dice" id="dice-2">❓</div>
                <div class="dice" id="dice-3">❓</div>
            </div>
            <button id="btn-roll" class="btn-roll" onclick="rollDice()">🎲 LẮC!</button>
        </div>

        <div class="info-card">
            <div class="info-title">🎁 Nhiệm vụ hôm nay</div>
            <div>Chơi 5 ván để nhận <b>+500 🪙</b></div>
            <div class="progress-bar"><div id="task-progress" style="width: 0%;"></div></div>
        </div>

        <div class="info-card">
            <div class="info-title">📜 Lịch sử gần đây</div>
            <div id="history-list">Chưa có ván nào.</div>
        </div>
    </div>

    <!-- SCRIPT GAME & ÂM THANH UNLOCK -->
    <script>
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            // Unlock audio trên iOS Safari
            try {
                const buffer = audioCtx.createBuffer(1, 1, 22050);
                const source = audioCtx.createBufferSource();
                source.buffer = buffer;
                source.connect(audioCtx.destination);
                source.start(0);
            } catch(e) {}

            const statusEl = document.getElementById('sound-status');
            if (statusEl) {
                statusEl.textContent = '🔊 Âm thanh: Đã kích hoạt';
                statusEl.style.color = '#81c784';
                statusEl.style.background = '#1b2e1b';
                statusEl.style.borderColor = '#2e552e';
            }
        }

        // Kích hoạt loa ngay khi chạm vào bất kỳ điểm nào trên màn hình
        ['touchstart', 'click', 'pointerdown'].forEach(evt => {
            document.addEventListener(evt, initAudio, { once: true });
        });

        function playCoinSound() {
            initAudio();
            try {
                const ctx = audioCtx;
                if (!ctx || ctx.state !== 'running') return;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(1200, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(1800, ctx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.3, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.08);
            } catch (e) {}
        }

        function playRollSound() {
            initAudio();
            try {
                const ctx = audioCtx;
                if (!ctx || ctx.state !== 'running') return;
                let count = 0;
                const interval = setInterval(() => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(150 + Math.random() * 250, ctx.currentTime);
                    gain.gain.setValueAtTime(0.3, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.06);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.06);

                    count++;
                    if (count >= 10) clearInterval(interval);
                }, 90);
            } catch (e) {}
        }

        function playWinSound() {
            initAudio();
            try {
                const ctx = audioCtx;
                if (!ctx || ctx.state !== 'running') return;
                const notes = [523.25, 659.25, 783.99];
                notes.forEach((freq, idx) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.12);
                    gain.gain.setValueAtTime(0.3, ctx.currentTime + idx * 0.12);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + idx * 0.12 + 0.2);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(ctx.currentTime + idx * 0.12);
                    osc.stop(ctx.currentTime + idx * 0.12 + 0.2);
                });
            } catch (e) {}
        }

        function playJackpotSound() {
            initAudio();
            try {
                const ctx = audioCtx;
                if (!ctx || ctx.state !== 'running') return;
                const notes = [523.25, 659.25, 783.99, 1046.50, 1318.51];
                notes.forEach((freq, idx) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.1);
                    gain.gain.setValueAtTime(0.35, ctx.currentTime + idx * 0.1);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + idx * 0.1 + 0.3);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(ctx.currentTime + idx * 0.1);
                    osc.stop(ctx.currentTime + idx * 0.1 + 0.3);
                });
            } catch (e) {}
        }

        const mascots = ['🍐', '🦀', '🦐', '🐟', '🐓', '🦌'];

        let coin = 1000;
        let currentBetAmount = 100;
        let selectedMascots = [];
        let streak = 0;
        let gamesPlayed = 0;
        let highScore = 1000;

        function selectMascot(mascot, element) {
            playCoinSound();
            
            if (selectedMascots.includes(mascot)) {
                selectedMascots = selectedMascots.filter(m => m !== mascot);
                element.classList.remove('selected');
            } else {
                if (selectedMascots.length >= 3) {
                    alert("Bạn chỉ được chọn tối đa 3 linh vật!");
                    return;
                }
                selectedMascots.push(mascot);
                element.classList.add('selected');
            }
        }

        function setBet(amount, element) {
            playCoinSound();
            currentBetAmount = amount;
            document.querySelectorAll('.bet-btn').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');
        }

        function rollDice() {
            if (selectedMascots.length === 0) {
                alert("Vui lòng chọn ít nhất 1 linh vật để đặt cược!");
                return;
            }

            const totalBetCost = currentBetAmount * selectedMascots.length;
            if (coin < totalBetCost) {
                alert("Bạn không đủ Coin để đặt cược!");
                return;
            }

            coin -= totalBetCost;
            updateUI();

            const btnRoll = document.getElementById('btn-roll');
            const diceElements = [
                document.getElementById('dice-1'),
                document.getElementById('dice-2'),
                document.getElementById('dice-3')
            ];

            btnRoll.disabled = true;
            playRollSound();

            diceElements.forEach(dice => {
                dice.textContent = '❓';
                dice.classList.add('dice-shake');
            });

            setTimeout(() => {
                diceElements.forEach(dice => dice.classList.remove('dice-shake'));

                const results = [
                    mascots[Math.floor(Math.random() * mascots.length)],
                    mascots[Math.floor(Math.random() * mascots.length)],
                    mascots[Math.floor(Math.random() * mascots.length)]
                ];

                diceElements[0].textContent = results[0];
                diceElements[1].textContent = results[1];
                diceElements[2].textContent = results[2];

                calculateResult(results, totalBetCost);

                btnRoll.disabled = false;
            }, 1200);
        }

        function calculateResult(results, totalBetCost) {
            let winnings = 0;
            let matchCount = 0;

            selectedMascots.forEach(mascot => {
                const count = results.filter(r => r === mascot).length;
                if (count > 0) {
                    winnings += (currentBetAmount * count) + currentBetAmount;
                    matchCount += count;
                }
            });

            coin += winnings;
            gamesPlayed++;

            if (winnings > 0) {
                streak++;
                if (matchCount === 3 && selectedMascots.length === 1) {
                    playJackpotSound();
                } else {
                    playWinSound();
                }
            } else {
                streak = 0;
            }

            if (coin > highScore) {
                highScore = coin;
            }

            const historyList = document.getElementById('history-list');
            const netProfit = winnings - totalBetCost;
            const resultText = netProfit >= 0 ? `+${netProfit}` : `${netProfit}`;
            const historyItem = document.createElement('div');
            historyItem.style.margin = "4px 0";
            historyItem.textContent = `Ván ${gamesPlayed}: ${results.join(' ')} (${resultText} 🪙)`;
            
            if (historyList.textContent === "Chưa có ván nào.") historyList.textContent = "";
            historyList.prepend(historyItem);

            updateUI();
        }

        function updateUI() {
            document.getElementById('coin-amount').textContent = coin;
            document.getElementById('high-score').textContent = highScore;
            document.getElementById('win-streak').textContent = streak;
            document.getElementById('total-games').textContent = gamesPlayed;

            const progressPercent = Math.min((gamesPlayed / 5) * 100, 100);
            document.getElementById('task-progress').style.width = progressPercent + '%';

            if (gamesPlayed === 5 && !window.taskRewarded) {
                coin += 500;
                window.taskRewarded = true;
                playJackpotSound();
                alert("🎉 Chúc mừng bạn đã hoàn thành nhiệm vụ 5 ván và nhận +500 🪙!");
                document.getElementById('coin-amount').textContent = coin;
            }
        }
    </script>
</body>
</html>
